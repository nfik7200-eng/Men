# Watchtower environment file. On the VPS this becomes /etc/watchtower/watchtower.env (mode 0640, root:watchtower).
# Plain KEY=value lines only: no `export`, no shell expansion, no inline comments (systemd and the deploy scripts both read it).
# Every variable below is one the code actually reads (watchtower/config.py, watchtower/schedule.py, shopping/*, eBay adapter).
# NO REAL VALUES belong in this file in git. Lines containing YOUR_* are placeholders: the deploy scripts and
# watchtower-web.service REFUSE to run until you replace them. For local development do not use this file; defaults suffice.

# ---- Database (SQLite, WAL). MUST be an absolute path OUTSIDE the release directory, or updates/rollbacks lose it.
# Four slashes = absolute path. Default if unset: <release dir>/data/watchtower.db (wrong for a server).
WATCHTOWER_DB_URL=sqlite:////var/lib/watchtower/watchtower.db

# ---- Admin (fail-closed): unset or < 20 characters keeps /admin DISABLED. Generate one on the server, e.g.
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"      (never reuse a password; never commit it)
WATCHTOWER_ADMIN_TOKEN=YOUR_ADMIN_TOKEN_MIN_20_CHARS

# ---- Behind nginx + TLS (see deploy/nginx/watchtower.conf). Set both to 1 ONLY when nginx is in front and
#      only nginx can reach the app port (the unit binds 127.0.0.1). The public host name nginx forwards in Host must
#      equal the host browsers use, or the CSRF Origin check returns 403 on every form POST.
WATCHTOWER_TRUST_PROXY=1
WATCHTOWER_COOKIE_SECURE=1
# Requests per minute per client IP (login and research buckets are capped lower in code); 0 disables the limiter.
WATCHTOWER_RATE_LIMIT=120

# ---- Crawler identity. REQUIRED (a real, reachable email or http(s) URL that you own) before ANY live collection.
#      Placeholder/example domains are rejected by the app (config.contact_ok). Left commented = collection refuses.
# WATCHTOWER_CONTACT=YOUR_CONTACT

# ---- Fetcher pacing (floors are enforced in code: real merchants never faster than 2 s/request; Crawl-delay only raises it)
WATCHTOWER_MIN_DELAY=1.5
WATCHTOWER_HTTP_TIMEOUT=20
WATCHTOWER_MAX_RETRIES=3

# ---- Scheduler: second of the opt-ins. 0 = `schedule run-due` does nothing. The first is "enabled": true in
#      /var/lib/watchtower/schedule.json; the third is enabling watchtower-collect.timer. See docs/DEPLOYMENT.md.
WATCHTOWER_SCHEDULER_ENABLED=0

# ---- Per-source product-page budget per run: WATCHTOWER_BUDGET_<SOURCE_KEY upper-case>, positive integer, ceiling 500.
#      Unset = adapter default. Keys: ADAFRUIT, SPARKFUN, BOOKS_TOSCRAPE, WEBSCRAPER_IO_STATIC, EBAY_BROWSE.
# WATCHTOWER_BUDGET_ADAFRUIT=60
# WATCHTOWER_BUDGET_SPARKFUN=40

# ---- Optional local LLM phrasing layer (Ollama). OFF unless OLLAMA_URL is set. No paid API is ever used.
#      The URL must be reachable from the VPS; running Ollama on a small VPS needs several GB RAM: not provisioned here.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ---- Optional config files. Defaults are inside the release dir (data/affiliate.json is absent = affiliate off;
#      data/import_rules.json ships with the code). Point them at the state dir to keep edits across releases.
#      Affiliate data must never influence ranking (enforced by a test).
# AFFILIATE_CONFIG=/var/lib/watchtower/affiliate.json
# IMPORT_RULES=/var/lib/watchtower/import_rules.json

# ---- eBay adapter: SCAFFOLDING ONLY (mock-tested, never run against eBay). Do NOT describe it as live and do not set
#      these until it has run in the eBay sandbox and the API License Agreement has been read. Secrets belong here only
#      on the server, never in git.
# EBAY_ENV=sandbox
# EBAY_MARKETPLACE=EBAY_US
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_CAMPAIGN_ID=
# EBAY_QUERIES=
