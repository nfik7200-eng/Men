# BIP configuration template. Copy to .env (git-ignored) and adjust.
# Settings are NOT read from .env implicitly; run commands with:  uv run --env-file .env <cmd>
# Placeholders only. Never put real credentials in this file.

# development | test | production
BIP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
BIP_LOG_LEVEL=INFO
# json | text   (production requires json)
BIP_LOG_FORMAT=text

# All BIP data lives under this root. Point it at separate storage before ingesting at scale.
BIP_DATA_ROOT=./var/data
# Optional scratch space; defaults to $BIP_DATA_ROOT/tmp
# BIP_TEMP_DIR=
# Hard cap on BIP's own data usage (prototype cap per ADR-011)
BIP_MAX_DATA_BYTES=5GiB
# Writes pause if free space on the data filesystem would fall below either floor
BIP_MIN_FREE_BYTES=5GiB
BIP_MIN_FREE_RATIO=0.05

# Comma-separated; must be known chains (ethereum, solana, base, arbitrum, bnb)
BIP_ENABLED_CHAINS=ethereum,solana

# Router feature flags (reserved; cross-verification is not applied yet)
BIP_ROUTER__CROSS_VERIFICATION_SAMPLE_RATE=0.01

# HTTP API (BIP 0.1). There is no authentication: keep the host on loopback.
BIP_API__HOST=127.0.0.1
BIP_API__PORT=8000
# Exact origins allowed by CORS, comma-separated. Wildcards are rejected.
BIP_API__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BIP_API__MAX_REQUEST_BYTES=65536

# Operational SQLite database: a file name inside $BIP_DATA_ROOT/operational/ (never a path)
BIP_DATABASE__FILENAME=bip.sqlite3

# ---------------------------------------------------------------- RPC providers
# Keyless public endpoints (PublicNode Ethereum, Solana public mainnet) work without settings.
# Credentialed providers take a FULL endpoint URL (it usually embeds your key, so it is treated
# as a secret). The host must match the provider's allowed_hosts in bip/providers/registry.toml.
# BIP_PROVIDER_ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# BIP_PROVIDER_INFURA_ETH_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# BIP_PROVIDER_ANKR_ETH_URL=https://rpc.ankr.com/eth/YOUR_KEY
# BIP_PROVIDER_QUICKNODE_ETH_URL=https://YOUR-ENDPOINT.quiknode.pro/YOUR_TOKEN/
# BIP_PROVIDER_HELIUS_SOL_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# BIP_PROVIDER_ALCHEMY_SOL_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# BIP_PROVIDER_QUICKNODE_SOL_URL=https://YOUR-ENDPOINT.solana-mainnet.quiknode.pro/YOUR_TOKEN/
# BIP_PROVIDER_PUBLICNODE_SOL_URL=   # keyless; confirm the hostname on publicnode.com first

# RPC client limits
BIP_RPC__TIMEOUT_S=10
BIP_RPC__MAX_ATTEMPTS=3
BIP_RPC__MAX_RESPONSE_BYTES=8388608
# Route requests through HTTPS_PROXY (disables local IP pinning; the proxy resolves hosts)
BIP_RPC__USE_ENV_PROXY=false

# Wallet ingestion bounds
BIP_INGEST__DEFAULT_LIMIT=20
BIP_INGEST__MAX_LIMIT=50
BIP_INGEST__ETHEREUM_LOOKBACK_BLOCKS=2000
BIP_INGEST__ETHEREUM_LOG_CHUNK_BLOCKS=500
# confirmed | finalized
BIP_INGEST__SOLANA_COMMITMENT=finalized
BIP_INGEST__RUN_DEADLINE_S=90
BIP_INGEST__MAX_RPC_CALLS_PER_RUN=150

# Optional services (not used by any code yet). Prefer *_FILE secret files in production.
# BIP_POSTGRES_DSN=postgresql://bip:CHANGE_ME@127.0.0.1:5432/bip
# BIP_REDIS_URL=redis://127.0.0.1:6379/0

# Wallet ingestion: Solana token accounts and repair (defaults shown)
BIP_INGEST__SOLANA_TOKEN_ACCOUNTS_LIMIT=5
BIP_INGEST__SOLANA_TOKEN_ACCOUNT_SIGNATURE_LIMIT=10
BIP_INGEST__SOLANA_PLACEHOLDER_REPAIR_LIMIT=10
BIP_INGEST__ETHEREUM_PARTIAL_REPAIR_LIMIT=10
BIP_INGEST__REPAIR_MAX_ATTEMPTS=5

# Discovery over stored data (local database only; defaults shown)
BIP_DISCOVERY__LOOKBACK_HOURS=48
BIP_DISCOVERY__BASELINE_DAYS=30
BIP_DISCOVERY__MIN_BASELINE=10
BIP_DISCOVERY__MAD_THRESHOLD=3.5
BIP_DISCOVERY__COOLDOWN_SECONDS=21600
BIP_DISCOVERY__TTL_DAYS=7
BIP_DISCOVERY__MAX_SIGNALS_PER_DETECTOR=50
BIP_DISCOVERY__MAX_ROWS_SCANNED=20000

# Authentication. "disabled" is only allowed on a loopback address.
# Create the first admin: uv run python -m bip.tools.users create admin --role admin
BIP_AUTH__MODE=disabled
BIP_AUTH__COOKIE_SECURE=true
BIP_AUTH__SESSION_TTL_HOURS=12
BIP_AUTH__IDLE_TIMEOUT_MINUTES=60
BIP_AUTH__LOGIN_MAX_FAILURES=5
BIP_AUTH__LOGIN_LOCKOUT_MINUTES=15
BIP_AUTH__RATE_LIMIT_PER_MINUTE=600
BIP_AUTH__LOGIN_RATE_LIMIT_PER_MINUTE=10
# Only behind a reverse proxy you control:
# BIP_AUTH__TRUST_PROXY_HEADERS=true

# Background scheduler (off by default). watchlist_refresh CONTACTS PROVIDERS: keep it off
# until the owner has approved the provider usage.
BIP_WORKERS__ENABLED=false
BIP_WORKERS__DISCOVERY_INTERVAL_MINUTES=60
BIP_WORKERS__MAINTENANCE_INTERVAL_HOURS=24
BIP_WORKERS__BACKUP_ENABLED=false
BIP_WORKERS__BACKUP_INTERVAL_HOURS=24
BIP_WORKERS__BACKUP_KEEP=7
BIP_WORKERS__WATCHLIST_REFRESH_ENABLED=false
# Block collector (CONTACTS PROVIDERS; off until the owner approves the usage).
BIP_WORKERS__COLLECTOR_ENABLED=false
BIP_WORKERS__COLLECTOR_INTERVAL_MINUTES=30
BIP_COLLECTOR__BLOCKS_PER_RUN=20
BIP_COLLECTOR__MIN_NATIVE_VALUE_ETH=10
BIP_COLLECTOR__MAX_RECEIPTS_PER_RUN=60
BIP_COLLECTOR__MAX_POOLS_PER_RUN=10
# Pool factories you verified yourself (comma-separated 0x addresses). Uniswap v2/v3 are built in;
# pools from any other factory are recorded but never feed token transfers or reserve watching.
BIP_COLLECTOR__EXTRA_FACTORIES=
BIP_COLLECTOR__MAX_BLOCK_ATTEMPTS=3
BIP_COLLECTOR__HUB_POOL_THRESHOLD=25
BIP_COLLECTOR__MAX_TRACKED_TOKENS=500000
# Solana finalized-slot collector (CONTACTS PROVIDERS; off by default).
BIP_WORKERS__SOLANA_COLLECTOR_ENABLED=false
BIP_WORKERS__SOLANA_COLLECTOR_INTERVAL_MINUTES=5
BIP_SOLANA_COLLECTOR__BLOCKS_PER_RUN=10
BIP_SOLANA_COLLECTOR__MAX_LAG_SLOTS=2000
BIP_SOLANA_COLLECTOR__MIN_SOL_TRANSFER=500
