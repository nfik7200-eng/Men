# /etc/caddy/Caddyfile   (example)
# Caddy obtains and renews the HTTPS certificate by itself for a public name that points at this
# host. On a private network use `tls internal` instead of a public name.
bip.example.org {
	encode zstd gzip

	# The built frontend (frontend/dist copied here).
	root * /srv/bip/web
	file_server

	# API over the Unix socket. Caddy's user must be in group bip. Caddy sets X-Forwarded-For,
	# which BIP trusts because only this proxy can open the socket
	# (BIP_AUTH__TRUST_PROXY_HEADERS=true).
	handle /api/* {
		reverse_proxy unix//run/bip/api.sock {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Single-page app: unknown paths serve index.html.
	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 1MB
	}
	log {
		output file /var/log/caddy/bip.log
		format json
	}
}
