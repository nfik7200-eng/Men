# BIP production environment. Copy to /etc/bip/bip.env, then: chown root:bip, chmod 640.
# Check it before starting:  python -m bip.tools.preflight --env-file /etc/bip/bip.env
# Nothing here is a secret by default. Put any key an optional provider needs in this file only
# (never in git), and never in a command line.

BIP_ENV=production
BIP_LOG_FORMAT=json
BIP_LOG_LEVEL=INFO

# Persistent storage. Use a separate volume if the root disk is shared or nearly full.
BIP_DATA_ROOT=/var/lib/bip
BIP_MAX_DATA_BYTES=5GiB
BIP_MIN_FREE_BYTES=5GiB

# The API listens on loopback only; the reverse proxy is the single public entrance.
BIP_API__HOST=127.0.0.1
BIP_API__PORT=8000
# The exact public origin of the site. HTTPS only.
BIP_API__CORS_ORIGINS=https://bip.example.org

# Authentication is mandatory on a reachable host.
BIP_AUTH__MODE=required
BIP_AUTH__COOKIE_SECURE=true
# Only because Caddy/nginx on this host sets X-Forwarded-For and the API is loopback-bound.
BIP_AUTH__TRUST_PROXY_HEADERS=true

# Background jobs: local-only work is safe. Scheduled backups on.
BIP_WORKERS__ENABLED=true
BIP_WORKERS__BACKUP_ENABLED=true
BIP_WORKERS__BACKUP_INTERVAL_HOURS=24
BIP_WORKERS__BACKUP_KEEP=7

# Jobs that contact providers stay OFF until a free endpoint is configured and its limits are
# checked (see deploy/README.md, "Turning collection on"). Each run is capped at 150 requests and
# 90 seconds per chain, enforced by validation.
BIP_WORKERS__COLLECTOR_ENABLED=false
BIP_WORKERS__SOLANA_COLLECTOR_ENABLED=false
BIP_WORKERS__WATCHLIST_REFRESH_ENABLED=false

# Optional local model (never required). Leave as none unless an Ollama is already running here.
BIP_AI__PROVIDER=none
